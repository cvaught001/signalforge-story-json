{
  "type": "object",
  "required": [
    "$schema",
    "schema",
    "schema_version",
    "project_title",
    "format",
    "version",
    "aspect_ratio",
    "defaults",
    "negative_prompt",
    "audio",
    "global_style",
    "scenes",
    "character_locks",
    "studio",
    "model",
    "tone",
    "dialogue",
    "story_continuity",
    "prompt_style_override",
    "runtime",
    "render_settings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "signalforge.story"
    },
    "schema_version": {
      "const": "1.0"
    },
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "signal-forge-markdown"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "aspect_ratio": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "type": "object",
      "required": [
        "prompt_compilation_mode",
        "image_conditioning",
        "allow_visible_text",
        "audio_generation",
        "image_strength",
        "image_crf"
      ],
      "properties": {
        "prompt_compilation_mode": {
          "enum": [
            "legacy",
            "ltx23_concise"
          ]
        },
        "image_conditioning": {
          "type": "boolean"
        },
        "allow_visible_text": {
          "type": "boolean"
        },
        "audio_generation": {
          "type": "boolean"
        },
        "image_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "image_crf": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": true
    },
    "negative_prompt": {
      "type": "string"
    },
    "audio": {
      "type": "boolean"
    },
    "global_style": {
      "type": "object",
      "required": [
        "description",
        "photographic_style",
        "color_palette",
        "lighting",
        "mood"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "photographic_style": {
          "type": "string"
        },
        "color_palette": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lighting": {
          "type": "string"
        },
        "mood": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "title",
          "duration_seconds",
          "scene",
          "image_refs",
          "**references",
          "**duration",
          "environment_lock",
          "subjects"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60
          },
          "scene": {
            "type": "string",
            "minLength": 1
          },
          "image_refs": {
            "type": "object",
            "required": [
              "references"
            ],
            "properties": {
              "references": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "required": [
                        "image"
                      ],
                      "properties": {
                        "image": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string"
                        },
                        "frame_idx": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "strength": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "crf": {
                          "type": [
                            "integer",
                            "string"
                          ]
                        }
                      },
                      "additionalProperties": true
                    }
                  ]
                }
              }
            },
            "additionalProperties": true
          },
          "**references": {
            "type": "string"
          },
          "**duration": {
            "type": "string"
          },
          "environment_lock": {
            "type": "object",
            "required": [
              "references"
            ],
            "properties": {
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "image"
                  ],
                  "properties": {
                    "image": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "frame_idx": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "strength": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "crf": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "character",
                "description",
                "action"
              ],
              "properties": {
                "character": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "character_locks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "character_file"
        ],
        "properties": {
          "character_file": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "studio": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "tone": {
      "type": "string"
    },
    "dialogue": {
      "type": "boolean"
    },
    "story_continuity": {
      "type": "string"
    },
    "prompt_style_override": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "required": [
        "scene_count",
        "total_seconds",
        "seconds_per_scene"
      ],
      "properties": {
        "scene_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "seconds_per_scene": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "render_settings": {
      "type": "object",
      "required": [
        "enabled",
        "values"
      ],
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalForge FinalRevision story profile",
  "description": "Derived from FinalRevision_v1.14.json; distinct from the shared SignalForge schema, especially boolean audio."
}
